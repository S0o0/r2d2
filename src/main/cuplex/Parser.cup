package fr.ul.miashs.compil.parsing;

import java_cup.runtime.*;
import fr.ul.miashs.compil.arbre.*;
import fr.ul.miashs.compil.tds.*;
import java.util.ArrayList;

/* ── Champs partagés dans le parser ──────────────────────────────── */
parser code {:
    public Table tds = new Table();
    public Symbole scopeActuel = null;
    public int nbParamActuel = 0;
    public int nbVarLocActuel = 0;
:};

/* ── Déclaration des terminaux (tokens du lexer) ─────────────────── */
terminal            TYPE_INT, TYPE_VOID;
terminal            SI, SINON, TANTQUE, RETOUR;
terminal            ECRIRE, LIRE;
terminal            PLUS, MOINS, MUL, DIV;
terminal            SUP, INF, SUP_EG, INF_EG, EGAL, DIFF;
terminal            AFF;
terminal            PAR_OUV, PAR_FER, ACCOLADE_OUV, ACCOLADE_FER;
terminal            VIRGULE, POINT_VIRG;
terminal Integer    CONST_ENT;
terminal String     IDF;

/* ── Déclaration des non-terminaux ───────────────────────────────── */
non terminal Prog                   programme;
non terminal ArrayList<Noeud>       liste_declarations_globales;
non terminal ArrayList<Noeud>       liste_fonctions;
non terminal Fonction               fonction;
non terminal String                 entete_fonction_void;
non terminal String                 entete_fonction_int;
non terminal ArrayList<Symbole>     liste_params;
non terminal ArrayList<Symbole>     params;
non terminal ArrayList<Noeud>       liste_instructions;
non terminal Noeud                  instruction;
non terminal Noeud                  declaration_locale;
non terminal Noeud                  expression;
non terminal Noeud                  condition;
non terminal Bloc                   bloc;
non terminal ArrayList<Noeud>       liste_args;
non terminal ArrayList<Noeud>       args;

/* ── Précédences (du moins au plus prioritaire) ──────────────────── */
precedence left PLUS, MOINS;
precedence left MUL, DIV;

/* ============================================================
 * Grammaire
 * ============================================================ */

/* ── Programme ───────────────────────────────────────────────────── */
programme ::= liste_declarations_globales:ld liste_fonctions:lf
    {:
        Prog prog = new Prog();
        for (Noeud f : lf) prog.ajouterUnFils(f);
        System.out.println("=== Arbre abstrait ===");
        TxtAfficheur.afficher(prog);
        System.out.println("\n=== Table des symboles ===");
        System.out.println(parser.tds);
        RESULT = prog;
    :}
    | liste_fonctions:lf
    {:
        Prog prog = new Prog();
        for (Noeud f : lf) prog.ajouterUnFils(f);
        System.out.println("=== Arbre abstrait ===");
        TxtAfficheur.afficher(prog);
        System.out.println("\n=== Table des symboles ===");
        System.out.println(parser.tds);
        RESULT = prog;
    :}
    ;

/* ── Déclarations globales ───────────────────────────────────────── */
liste_declarations_globales ::= liste_declarations_globales:ld TYPE_INT IDF:nom POINT_VIRG
    {:
        Symbole s = new Symbole(nom, "int", "global", 0, 0, 0, 0, null);
        parser.tds.put(nom, s);
        RESULT = ld;
    :}
    | liste_declarations_globales:ld TYPE_INT IDF:nom AFF CONST_ENT:val POINT_VIRG
    {:
        Symbole s = new Symbole(nom, "int", "global", val, 0, 0, 0, null);
        parser.tds.put(nom, s);
        RESULT = ld;
    :}
    | TYPE_INT IDF:nom POINT_VIRG
    {:
        Symbole s = new Symbole(nom, "int", "global", 0, 0, 0, 0, null);
        parser.tds.put(nom, s);
        RESULT = new ArrayList<>();
    :}
    | TYPE_INT IDF:nom AFF CONST_ENT:val POINT_VIRG
    {:
        Symbole s = new Symbole(nom, "int", "global", val, 0, 0, 0, null);
        parser.tds.put(nom, s);
        RESULT = new ArrayList<>();
    :}
    ;

/* ── Liste de fonctions ──────────────────────────────────────────── */
liste_fonctions ::= liste_fonctions:lf fonction:f
    {:
        lf.add(f);
        RESULT = lf;
    :}
    | fonction:f
    {:
        ArrayList<Noeud> lf = new ArrayList<>();
        lf.add(f);
        RESULT = lf;
    :}
    ;

/* ── Entêtes de fonctions : règles séparées pour initialiser le scope
      AVANT de parser les params et le corps.
      C'est le remplacement des mid-rule actions. ──────────────────── */
entete_fonction_void ::= TYPE_VOID IDF:nom
    {:
        Symbole sf = new Symbole(nom, "void", "fonction", 0, 0, 0, 0, null);
        parser.tds.put(nom, sf);
        parser.scopeActuel    = sf;
        parser.nbParamActuel  = 0;
        parser.nbVarLocActuel = 0;
        RESULT = nom;
    :}
    ;

entete_fonction_int ::= TYPE_INT IDF:nom
    {:
        Symbole sf = new Symbole(nom, "int", "fonction", 0, 0, 0, 0, null);
        parser.tds.put(nom, sf);
        parser.scopeActuel    = sf;
        parser.nbParamActuel  = 0;
        parser.nbVarLocActuel = 0;
        RESULT = nom;
    :}
    ;

/* ── Fonctions ───────────────────────────────────────────────────── */
fonction ::= entete_fonction_void:nom PAR_OUV liste_params:lp PAR_FER
             ACCOLADE_OUV liste_instructions:li ACCOLADE_FER
    {:
        Symbole sf = parser.tds.rechercherSymbole(nom);
        Fonction f = new Fonction(sf);
        for (Noeud instr : li) f.ajouterUnFils(instr);
        parser.scopeActuel = null;
        RESULT = f;
    :}
    | entete_fonction_int:nom PAR_OUV liste_params:lp PAR_FER
      ACCOLADE_OUV liste_instructions:li ACCOLADE_FER
    {:
        Symbole sf = parser.tds.rechercherSymbole(nom);
        Fonction f = new Fonction(sf);
        for (Noeud instr : li) f.ajouterUnFils(instr);
        parser.scopeActuel = null;
        RESULT = f;
    :}
    ;

/* ── Paramètres ──────────────────────────────────────────────────── */
liste_params ::= params:lp
    {:  RESULT = lp; :}
    | /* vide */
    {:  RESULT = new ArrayList<>(); :}
    ;

params ::= params:lp VIRGULE TYPE_INT IDF:nom
    {:
        Symbole sp = new Symbole(nom, "int", "param", parser.nbParamActuel++, parser.scopeActuel);
        parser.tds.put(nom, sp);
        lp.add(sp);
        RESULT = lp;
    :}
    | TYPE_INT IDF:nom
    {:
        ArrayList<Symbole> lp = new ArrayList<>();
        Symbole sp = new Symbole(nom, "int", "param", parser.nbParamActuel++, parser.scopeActuel);
        parser.tds.put(nom, sp);
        lp.add(sp);
        RESULT = lp;
    :}
    ;

/* ── Bloc ────────────────────────────────────────────────────────── */
bloc ::= ACCOLADE_OUV liste_instructions:li ACCOLADE_FER
    {:
        Bloc b = new Bloc();
        for (Noeud instr : li) b.ajouterUnFils(instr);
        RESULT = b;
    :}
    ;

/* ── Liste d'instructions ────────────────────────────────────────── */
liste_instructions ::= liste_instructions:li instruction:i
    {:
        li.add(i);
        RESULT = li;
    :}
    | liste_instructions:li declaration_locale:d
    {:
        if (d != null) li.add(d);
        RESULT = li;
    :}
    | /* vide */
    {:  RESULT = new ArrayList<>(); :}
    ;

/* ── Déclaration locale ──────────────────────────────────────────── */
declaration_locale ::= TYPE_INT IDF:nom POINT_VIRG
    {:
        Symbole s = new Symbole(nom, "int", "local", parser.nbVarLocActuel++, parser.scopeActuel);
        parser.tds.put(nom, s);
        RESULT = null;
    :}
    | TYPE_INT IDF:nom AFF CONST_ENT:val POINT_VIRG
    {:
        Symbole s = new Symbole(nom, "int", "local", parser.nbVarLocActuel++, parser.scopeActuel);
        parser.tds.put(nom, s);
        Idf idf = new Idf(s);
        Affectation aff = new Affectation();
        aff.setFilsGauche(idf);
        aff.setFilsDroit(new Const(val));
        RESULT = aff;
    :}
    ;

/* ── Instructions ────────────────────────────────────────────────── */
instruction ::=

    /* Affectation */
    IDF:nom AFF expression:e POINT_VIRG
    {:
        Symbole s = parser.tds.rechercherSymbole(nom);
        if (s == null) {
            s = new Symbole(nom, "int", "global", 0, 0, 0, 0, null);
            parser.tds.put(nom, s);
        }
        Idf idf = new Idf(s);
        Affectation aff = new Affectation();
        aff.setFilsGauche(idf);
        aff.setFilsDroit(e);
        RESULT = aff;
    :}

    /* Ecrire */
    | ECRIRE PAR_OUV expression:e PAR_FER POINT_VIRG
    {:
        Ecrire ecr = new Ecrire();
        ecr.setLeFils(e);
        RESULT = ecr;
    :}

    /* Appel de fonction comme instruction */
    | IDF:nom PAR_OUV liste_args:la PAR_FER POINT_VIRG
    {:
        Symbole s = parser.tds.rechercherSymbole(nom);
        if (s == null) {
            s = new Symbole(nom, "int", "global", 0, 0, 0, 0, null);
            parser.tds.put(nom, s);
        }
        Appel ap = new Appel(s);
        for (Noeud arg : la) ap.ajouterUnFils(arg);
        RESULT = ap;
    :}

    /* Si sans sinon */
    | SI PAR_OUV condition:c PAR_FER bloc:alors
    {:
        Si si = new Si();
        si.setCondition(c);
        si.setBlocAlors(alors);
        si.setBlocSinon(new Bloc());
        RESULT = si;
    :}

    /* Si avec sinon */
    | SI PAR_OUV condition:c PAR_FER bloc:alors SINON bloc:sinon
    {:
        Si si = new Si();
        si.setCondition(c);
        si.setBlocAlors(alors);
        si.setBlocSinon(sinon);
        RESULT = si;
    :}

    /* Tant que */
    | TANTQUE PAR_OUV condition:c PAR_FER bloc:b
    {:
        TantQue tq = new TantQue();
        tq.setCondition(c);
        tq.setBloc(b);
        RESULT = tq;
    :}

    /* Retour */
    | RETOUR expression:e POINT_VIRG
    {:
        Retour ret = new Retour(parser.scopeActuel);
        ret.setLeFils(e);
        RESULT = ret;
    :}
    ;

/* ── Expressions ─────────────────────────────────────────────────── */
expression ::=

    CONST_ENT:v
    {:  RESULT = new Const(v); :}

    | IDF:nom
    {:
        Symbole s = parser.tds.rechercherSymbole(nom);
        if (s == null) {
            s = new Symbole(nom, "int", "global", 0, 0, 0, 0, null);
            parser.tds.put(nom, s);
        }
        RESULT = new Idf(s);
    :}

    | LIRE PAR_OUV PAR_FER
    {:  RESULT = new Lire(); :}

    | IDF:nom PAR_OUV liste_args:la PAR_FER
    {:
        Symbole s = parser.tds.rechercherSymbole(nom);
        if (s == null) {
            s = new Symbole(nom, "int", "global", 0, 0, 0, 0, null);
            parser.tds.put(nom, s);
        }
        Appel ap = new Appel(s);
        for (Noeud arg : la) ap.ajouterUnFils(arg);
        RESULT = ap;
    :}

    | expression:g PLUS expression:d
    {:
        Plus p = new Plus();
        p.setFilsGauche(g);
        p.setFilsDroit(d);
        RESULT = p;
    :}

    | expression:g MOINS expression:d
    {:
        Moins m = new Moins();
        m.setFilsGauche(g);
        m.setFilsDroit(d);
        RESULT = m;
    :}

    | expression:g MUL expression:d
    {:
        Multiplication mul = new Multiplication();
        mul.setFilsGauche(g);
        mul.setFilsDroit(d);
        RESULT = mul;
    :}

    | expression:g DIV expression:d
    {:
        Division div = new Division();
        div.setFilsGauche(g);
        div.setFilsDroit(d);
        RESULT = div;
    :}

    | PAR_OUV expression:e PAR_FER
    {:  RESULT = e; :}
    ;

/* ── Conditions ──────────────────────────────────────────────────── */
condition ::=
    expression:g SUP expression:d
    {:  Superieur s = new Superieur(); s.setFilsGauche(g); s.setFilsDroit(d); RESULT = s; :}

    | expression:g INF expression:d
    {:  Inferieur s = new Inferieur(); s.setFilsGauche(g); s.setFilsDroit(d); RESULT = s; :}

    | expression:g SUP_EG expression:d
    {:  SuperieurEgal s = new SuperieurEgal(); s.setFilsGauche(g); s.setFilsDroit(d); RESULT = s; :}

    | expression:g INF_EG expression:d
    {:  InferieurEgal s = new InferieurEgal(); s.setFilsGauche(g); s.setFilsDroit(d); RESULT = s; :}

    | expression:g EGAL expression:d
    {:  Egal s = new Egal(); s.setFilsGauche(g); s.setFilsDroit(d); RESULT = s; :}

    | expression:g DIFF expression:d
    {:  Different s = new Different(); s.setFilsGauche(g); s.setFilsDroit(d); RESULT = s; :}
    ;

/* ── Arguments d'appel ───────────────────────────────────────────── */
liste_args ::= args:la
    {:  RESULT = la; :}
    | /* vide */
    {:  RESULT = new ArrayList<>(); :}
    ;

args ::= args:la VIRGULE expression:e
    {:
        la.add(e);
        RESULT = la;
    :}
    | expression:e
    {:
        ArrayList<Noeud> la = new ArrayList<>();
        la.add(e);
        RESULT = la;
    :}
    ;
